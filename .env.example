# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The Vercel AI Gateway: vercel.com/d?to=/[team]/~/ai-gateway/api-keys. The chat's model and the e2e agent both use it.
# Or link a Vercel project and run `vercel env pull .env.local`, which writes VERCEL_OIDC_TOKEN instead (valid 12 hours).
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
